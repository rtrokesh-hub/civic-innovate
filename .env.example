# ==============================================================================
# Civic Innovate Environment Configuration Template
# COPY THIS FILE TO YOUR SECURE ENVIRONMENT (DO NOT COMMIT REAL SECRETS)
# ==============================================================================

# Required: 256-bit (32+ bytes / 64 hex characters) cryptographic key for signing JWT tokens
CIVIC_JWT_SECRET=your_secure_256_bit_jwt_secret_here

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/civic_innovate_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Optional: Google Gemini API Key for AI Triage (falls back to Heuristic Engine if unset)
GEMINI_API_KEY=

# Server Port
SERVER_PORT=8080
